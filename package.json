{
  "name": "logseq-copilot",
  "version": "2.0.0",
  "description": "Connect to the Logseq API and use your notes while browsing.",
  "license": "GPL-3.0-only",
  "repository": {
    "type": "git",
    "url": "https://github.com/EINDEX/logseq-copilot.git"
  },
  "scripts": {
    "prettier": "prettier --write '**/*.{js,jsx,ts,tsx,json,css,scss,md}'",
    "prepare": "husky install",
    "docs:dev": "cd docs && npm run dev",
    "docs:build": "cd docs && npm run build",
    "docs:preview": "cd docs && npm run preview",
    "publish:edge": "node pipeline/edge-addon-publish.mjs",
    "publish:firefox": "web-ext sign -s .output/firefox-mv3 --channel listed --approval-timeout 0",
    "version:dev": "node scripts/dev-version.mjs",
    "version:reset": "git checkout HEAD -- package.json",
    "dev": "wxt",
    "dev:firefox": "wxt -b firefox",
    "build": "wxt build",
    "build:firefox": "wxt build -b firefox",
    "zip": "wxt zip",
    "zip:firefox": "wxt zip -b firefox",
    "postinstall": "wxt prepare",
    "test": "vitest run",
    "test:coverage": "vitest run --coverage",
    "typecheck": "tsc --noEmit",
    "test:integration": "vitest run --config vitest.integration.config.ts",
    "build:e2e": "WXT_E2E=true wxt build",
    "test:e2e": "wxt build && pnpm build:e2e && pnpm test:e2e:run",
    "test:e2e:run": "playwright test -c tests/e2e/playwright.config.ts"
  },
  "dependencies": {
    "@dnd-kit/core": "^6.3.1",
    "@dnd-kit/sortable": "^10.0.0",
    "@dnd-kit/utilities": "^3.2.2",
    "@radix-ui/react-checkbox": "^1.3.2",
    "@radix-ui/react-dialog": "^1.1.14",
    "@radix-ui/react-dropdown-menu": "^2.1.15",
    "@radix-ui/react-label": "^2.1.7",
    "@radix-ui/react-radio-group": "^1.3.7",
    "@radix-ui/react-separator": "^1.1.7",
    "@radix-ui/react-slot": "^1.2.3",
    "@radix-ui/react-switch": "^1.2.5",
    "@radix-ui/react-tooltip": "^1.2.7",
    "@tabler/icons-react": "^2.47.0",
    "@webext-core/messaging": "^2.3.0",
    "class-variance-authority": "^0.7.1",
    "clsx": "^2.1.1",
    "date-fns": "^2.30.0",
    "date-fns-tz": "^2.0.1",
    "liquidjs": "^10.21.1",
    "lucide-react": "^0.511.0",
    "marked": "^4.3.0",
    "react": "^18.3.1",
    "react-dom": "^18.3.1",
    "react-router-dom": "^7.6.2",
    "tailwind-merge": "^3.3.1",
    "tailwindcss-animate": "^1.0.7",
    "turndown": "^7.2.0",
    "tw-animate-css": "^1.3.4"
  },
  "devDependencies": {
    "@plasmohq/edge-addons-api": "^2.0.0",
    "@playwright/test": "1.64.1",
    "@tailwindcss/typography": "^0.5.16",
    "@tailwindcss/vite": "^4.1.10",
    "@testing-library/dom": "^10.4.2",
    "@testing-library/react": "^16.3.3",
    "@types/marked": "^4.3.2",
    "@types/react": "^18.3.23",
    "@types/react-dom": "^18.3.7",
    "@types/turndown": "^5.0.5",
    "@vitest/coverage-v8": "^3.2.7",
    "@wxt-dev/module-react": "^1.1.3",
    "archiver": "^5.3.2",
    "autoprefixer": "^10.4.21",
    "axios": "^1.10.0",
    "css-loader": "^6.11.0",
    "file-loader": "^6.2.0",
    "fs-extra": "^11.3.0",
    "happy-dom": "^21.0.3",
    "html-loader": "^4.2.0",
    "husky": "^8.0.3",
    "mockzilla": "^0.14.0",
    "playwright-core": "^1.64.1",
    "postcss": "^8.5.6",
    "prettier": "^2.8.8",
    "react-refresh": "^0.14.2",
    "react-refresh-typescript": "^2.0.10",
    "sass": "^1.89.2",
    "sass-loader": "^13.3.3",
    "source-map-loader": "^3.0.2",
    "style-loader": "^3.3.4",
    "tailwindcss": "^4.1.10",
    "ts-loader": "^9.5.2",
    "type-fest": "^3.13.1",
    "typescript": "^5.9.3",
    "vitest": "^3.2.7",
    "web-ext": "^10.8.0",
    "wxt": "^0.20.7"
  },
  "pnpm": {
    "overrides": {}
  }
}
