    justify-content: center;
    gap: 0.75rem;
    margin-bottom: 1.5rem;
  }

  .platform-icon {
    width: 32px;
    height: 32px;
  }

  .platform-name {
    font-size: 1.25rem;
    font-weight: 600;
    color: var(--sl-color-text);
  }

  .rating-info {
    display: flex;
    flex-direction: column;
    align-items: center;
    gap: 0.5rem;
  }

  .rating-stars {
    font-size: 1.5rem;
    color: #fbbf24;
    letter-spacing: 2px;
    text-shadow: 0 1px 2px rgba(0, 0, 0, 0.1);
