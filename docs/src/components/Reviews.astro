  /* 响应式设计 */
  @media (max-width: 768px) {
    .ratings-grid {
      grid-template-columns: 1fr;
      gap: 1.5rem;
    }

    .reviews-grid {
      grid-template-columns: 1fr;
      gap: 1.5rem;
    }

    .ratings-overview h2 {
      font-size: 2rem;
    }

    .user-reviews h3 {
